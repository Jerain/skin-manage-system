{
  "name": "皮肤管理客户端",
  "appid": "",
  "description": "皮肤管理小程序 - 客户端（预约、护理计划、会员中心、肤质对比）",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
